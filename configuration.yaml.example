# Loads default set of integrations. Do not remove.
default_config:

# Load frontend themes from the themes folder
frontend:
  themes: !include_dir_merge_named themes

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

logger:
  default: info
  logs:
    custom_components.thermozona: debug

# Test temperatuur sensoren
template:
  - sensor:
      - name: "Test Woonkamer Temperatuur"
        state: "20.0"
        unit_of_measurement: "°C"
        device_class: temperature
        unique_id: test_woonkamer_temperatuur

      - name: "Test Keuken Temperatuur"
        state: "19.5"
        unit_of_measurement: "°C"
        device_class: temperature
        unique_id: test_keuken_temperatuur
        
      - name: "Test Buiten Temperatuur"
        state: "10.0"
        unit_of_measurement: "°C"
        device_class: temperature
        unique_id: test_buiten_temperatuur

# Test switches voor de verdelers en warmtepomp
input_boolean:
  verdeler_1_groep_1:
    name: "Verdeler 1 Groep 1"
    icon: mdi:radiator
  
  verdeler_1_groep_2:
    name: "Verdeler 1 Groep 2"
    icon: mdi:radiator
  
  verdeler_1_groep_3:
    name: "Verdeler 1 Groep 3"
    icon: mdi:radiator
  
  verdeler_1_groep_4:
    name: "Verdeler 1 Groep 4"
    icon: mdi:radiator

# Thermozona configuratie
# Safety notice: Use at your own risk; ensure code-compliant installation/wiring. Authors/contributors are not liable for damage, injury, or fire.
thermozona:
  # Optional bounded heating correction from actual supply water and weather.
  # thermal_compensation:
  #   enabled: true
  #   supply_sensor: sensor.heatpump_heating_out
  #   reference_supply_c: 25.0
  #   reference_outside_c: 10.0
  #   max_sensor_age_minutes: 30
  #   solar_forecast_sensor: sensor.outdoor_solar_forecast_2h
  #   solar_gain_per_w_m2: 0.002
  outside_temp_sensor: sensor.test_buiten_temperatuur
  # heating_base_offset: 3.0
  # weather_slope_heat: 0.25
  # auto_heat_lockout_above_c: 18.0
  # auto_cool_lockout_below_c: 20.0
  # auto_min_changeover_minutes: 30
  # Optional shared PWM windows for a heat pump with small zone loads.
  # Give participating PWM zones the same pwm_cycle_time, e.g. 30 minutes.
  # pwm_staggering: false
  # demand_off_delay_minutes: 0

  # Optional Tibber-based house charging: inspect the plan before choosing auto.
  # price_charging:
  #   mode: preview
  #   boost_c: 0.5
  #   charge_hours: 3
  #   coast_hours: 6
  #   min_price_spread: 0.03
  #   thermal_model:
  #     normal_cop: 5.0
  #     charge_cop: 4.5
  #     loss_percent_per_hour: 1.0
  #     min_saving_percent: 5

  # Optional flow calculation tuning.
  # Keep it small here; see README for the full tuning matrix.
  flow:
    write_deadband_c: 0.3
    # preheat_enabled: true
    # preheat_forecast_sensor: sensor.outdoor_forecast_2h
    # preheat_solar_sensor: sensor.solar_irradiance_forecast_2h
    # preheat_solar_gain_per_w_m2: 0.002
    # cooling_dewpoint_sensor: sensor.indoor_dewpoint
    # cooling_floor_dewpoint_margin: 2.0
    # cooling_dehumidification_min_flow: 5.0
    # cooling_air_coil_only_offset: 5.0

  zones:
    woonkamer:
      circuits:
        - input_boolean.verdeler_1_groep_1
        - input_boolean.verdeler_1_groep_2
        - input_boolean.verdeler_1_groep_3
      temp_sensor: sensor.test_woonkamer_temperatuur
      # hysteresis: 0.2
      # zone_response: slow
      # zone_flow_weight: 1.0
      # zone_solar_weight: 1.4
      # zone_type: floor
      # floor_material: wood
      # cooling_dewpoint_margin: 2.0
      # cooling_dewpoint_protection: true
      # price_charging: true
      # setback_schedule: schedule.office_away
      # setback_c: 1.0
      # Optional learned warm-up before the schedule period ends.
      # schedule_recovery:
      #   enabled: true
      #   fallback_minutes: 120
      #   max_minutes: 180
      #   buffer_minutes: 15
      #   history_days: 7
      # For an air-coil zone, use zone_type: air_coil and set its water sensors:
      # air_coil_requested_water_sensor: sensor.thermozona_flow_temperature
      # air_coil_measured_water_sensor: sensor.heat_pump_supply_temperature

    keuken:
      circuits:
        - input_boolean.verdeler_1_groep_4
      temp_sensor: sensor.test_keuken_temperatuur
      # hysteresis: 0.25
      # zone_response: slow
      # zone_flow_weight: 1.0
      # zone_solar_weight: 0.2
      # zone_type: wall
      # heating_min_flow_c: 32.0
